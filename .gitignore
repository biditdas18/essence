# Python cache
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Secrets
.env
.env.*

# OS
.DS_Store

# Temporary files
*.log
*.tmp
*.bak

# Virtual environment
.venv/
.venv_recbole/

# Raw source data (large; downloaded by step0_download.py / preprocess.py)
data/raw/
data/amazon_raw/
data/movielens_raw/
data/*.tsv
data/*.gz
data/*.zip

# Embedding caches (large; regenerated by generate_embeddings*.py)
data/amazon_processed/embeddings_metadata.pkl
data/amazon_processed/embeddings_user_review.pkl
data/movielens_processed/embeddings_metadata.pkl
data/amazon_processed_*/embeddings_metadata.pkl
data/movielens_processed_*/embeddings_metadata.pkl
embeddings/item_embeddings.pkl
embeddings/*.index
embeddings/*.npy
experiments/adaptive_weighting/*_channel_a.pkl
experiments/adaptive_weighting/*_channel_b.pkl

# MovieLens-25M row-level interaction data (userId/movieId/rating/timestamp):
# GroupLens's license prohibits redistribution without separate permission,
# with no exception for derived/processed subsets. Regenerate locally via
# experiments/movielens/preprocess_movielens_step1.py (sampled_ratings.csv)
# and preprocess_movielens_step2.py (train.csv/test.csv), or the
# evaluation/step2_multiseed_movielens.py / step5_globalcutoff_build_evaluate.py /
# step1_ratingthresh_filter_build.py variants for the seed/globalcutoff/rt4
# copies. Movie catalog metadata (item_candidates.csv, item_text.csv,
# longtail_items.csv, tmdb_overviews.jsonl, tmdb_failures.jsonl) carries no
# per-user rating rows and is NOT covered by this rule -- see paper checklist
# Q12/README for the explicit distinction.
data/movielens_processed/train.csv
data/movielens_processed/test.csv
data/movielens_processed/sampled_ratings.csv
data/movielens_processed_*/train.csv
data/movielens_processed_*/test.csv

# Amazon Reviews 2023 row-level interaction/review data: license unverifiable
# (no explicit license file or tag published as of this writing), gitignored
# pending explicit confirmation rather than assumed permissible. Regenerate
# locally via experiments/amazon_books/preprocess_amazon.py (canonical) or the
# evaluation/step1_ratingthresh_filter_build.py / step2_multiseed_amazon.py /
# step5_globalcutoff_build_evaluate.py variants for the seed/globalcutoff/rt4
# copies. item_meta.csv (title/author/description, no user rows) is NOT
# covered by this rule -- see paper checklist Q12/README.
data/amazon_processed/train.csv
data/amazon_processed/test.csv
data/amazon_processed_*/train.csv
data/amazon_processed_*/test.csv

# Personal notes (Bidit's own reference, never committed or pushed)
paper/personal_notes/

# Scratch / debug
debug/

# LaTeX build artifacts
*.aux
*.out
*.log

# ---- added for the SOICT 2026 revision (Oct 2026) ----------------------------
# Second-encoder and expanded-cohort artefacts. Same rationale as the embedding
# caches above: large, and regenerated by generate_embeddings*.py.
embeddings/item_embeddings_mpnet.pkl
embeddings/item_embeddings_expanded.pkl
data/*_processed/embeddings_metadata_mpnet.pkl
data/*_processed_*/embeddings_metadata_mpnet.pkl

# Expanded / heavy / verification cohort splits. These are derived from the same
# row-level interaction data the two licence rules above exclude, so the same
# restriction applies; regenerate with data/preprocess.py --max-interactions and
# experiments/amazon_books/preprocess_amazon.py --proc-suffix.
data/train_interactions_*.pkl
data/test_interactions_*.pkl
data/long_tail_ids_*.pkl

# The heavy cohort's catalogue metadata is 51 MB, past GitHub's 50 MB warning
# threshold, and is a near-duplicate of data/amazon_processed/item_meta.csv for a
# larger item set. It carries no user rows, so this is a size decision rather
# than the licence rule above; regenerate with
# experiments/amazon_books/preprocess_amazon.py --proc-suffix _heavy.
data/amazon_processed_heavy/item_meta.csv

# RecBole atomic-format datasets and checkpoints (552 MB), rebuilt by
# experiments/recbole_baselines/run_recbole.py from the committed splits.
experiments/recbole_baselines/atomic/
log_tensorboard/

# Agent/editor session state
.claude/

# Numbered editing backups (*.bak is already covered above)
*.bak[0-9]

# LaTeX bibliography build products
*.bbl
*.blg
# ------------------------------------------------------------------------------

# scratch / verification run outputs (canonical results are *_v5 / *_v4 / *_peruser)
experiments/amazon_books/results_amazon_rerun.csv
experiments/amazon_books/results_amazon_pass2_rerun.csv
experiments/amazon_books/results_amazon_v3.csv
results/evaluation_results_v3.csv
results/evaluation_results_v4.csv
results/lastfm_det_run1.csv
results/lastfm_det_run2.csv
